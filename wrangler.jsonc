{
  // Producción. Sin account_id: cada quien usa su propia cuenta (wrangler login o CLOUDFLARE_ACCOUNT_ID).
  "name": "abandonabancoazteca",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // /api/* nunca es un archivo: siempre lo atiende el Worker (proxy de «Consulta la LFT»).
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false },
  "workers_dev": false,

  // «Consulta la LFT» corre completa en Cloudflare (src/lib/lftProxy.ts), sin servidores propios:
  //   LFT_DB   D1 con el texto oficial de cada fragmento + búsqueda FTS5 (BM25) + manifiesto.
  //   LFT_VEC  Vectorize con un vector @cf/baai/bge-m3 por fragmento.
  //   AI       Workers AI, para convertir la pregunta en vector con el mismo modelo.
  // Carga/actualización: node scripts/lft-cloudflare-index.mjs && powershell -File scripts/lft-cloudflare-load.ps1
  "d1_databases": [{ "binding": "LFT_DB", "database_name": "lft-rag", "database_id": "7baa8ca5-876d-47f1-954c-e123f2c9642c" }],
  "vectorize": [{ "binding": "LFT_VEC", "index_name": "lft-articulos" }],
  "ai": { "binding": "AI" },
  // Límite global (clave fija, no la IP): 20 consultas por minuto por ubicación de Cloudflare.
  "ratelimits": [{ "name": "LFT_RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } }],

  // Dominio propio (zona abandonabancoazteca.com en la cuenta de Cloudflare).
  "routes": [
    { "pattern": "abandonabancoazteca.com", "custom_domain": true },
    { "pattern": "www.abandonabancoazteca.com", "custom_domain": true }
  ],

  "env": {
    "review": {
      "name": "abandonabancoazteca-review",
      "main": "src/worker.ts",
      "assets": {
        "directory": "./dist-review",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [{ "binding": "LFT_DB", "database_name": "lft-rag", "database_id": "7baa8ca5-876d-47f1-954c-e123f2c9642c" }],
      "vectorize": [{ "binding": "LFT_VEC", "index_name": "lft-articulos" }],
      "ai": { "binding": "AI" },
      "ratelimits": [{ "name": "LFT_RATE_LIMITER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }],
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": false },
      "vars": { "REVIEW_MODE": "1" }
    }
  }
}
