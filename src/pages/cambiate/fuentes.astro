---
import Base from '../../layouts/Base.astro';
import CambiateNote from '../../components/CambiateNote.astro';
import data from '../../data/cambiate.json';
// Lista plana de todo valor con etiqueta de cambiate.json: fuente, fecha, herramienta.
interface Row { label: string; seen: string; status: string; url: string; read: string; tool: string }
const rows: Row[] = [];
const push = (label: string, o: any, seen: string) => rows.push({ label, seen, status: o.status, url: o.source_url, read: o.read_date, tool: o.tool });
const m = data.meta;
push('Valor de la UDI', m.udi, `${m.udi.value} el ${m.udi.date}`);
push('Cetes a 28 días', m.cetes28, `${m.cetes28.value}% el ${m.cetes28.date}`);
push('Tipo de cambio FIX', m.fix, `${m.fix.value} el ${m.fix.date}`);
push('Límite IPAB', data.protection.ipab, `${data.protection.ipab.limit_udis.toLocaleString('es-MX')} UDIs por persona y por banco (lo declara Banco Azteca)`);
push('Límite Fondo de SOFIPOs', data.protection.prosofipo, `${data.protection.prosofipo.limit_udis.toLocaleString('es-MX')} UDIs`);
for (const i of data.institutions) for (const p of i.products as any[]) push(`${i.name}: ${p.name}`, p, p.id === 'cuenta-operativa' ? `${p.fee_admin_mxn} pesos + IVA; exenciones publicadas` : p.id === 'guardadito' ? `GAT nominal ${p.gat_nominal_pct}%, vigencia hasta ${p.valid_to}` : `CAT promedio ${p.cat_avg_pct}% sin IVA, vigencia hasta ${p.valid_to}`);
for (const p of data.remittance_providers as any[]) push(p.name, p, p.id === 'wise' ? 'Deposita a CLABE o tarjeta; lista de bancos excluidos' : 'Depósito, cartera y efectivo; red de entrega nombrada');
push('Impuesto de EE. UU. a las remesas', data.us_remittance_tax, '1% con efectivo o instrumento físico');
const sources = rows.slice(0, 0);
---
<Base art="book" eyebrow="Cómo trabajamos" title="Fuentes de Cámbiate" description="Cada valor que usa Cámbiate, de dónde sale, cuándo se leyó y con qué herramienta." path="/cambiate/fuentes/" finance sources={sources} wide lead>
  <CambiateNote />
  <p class="ref-line">Si ves algo que no coincide con la página oficial, avísanos. <a href="/cambiate/metodo/">Cómo trabajamos</a>.</p>
  <div class="tbl-wrap">
    <table class="rt">
      <thead><tr><th>Valor</th><th>Qué vimos</th><th>Etiqueta</th><th>Fuente</th><th>Leído</th><th>Herramienta</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr><th scope="row">{r.label}</th><td>{r.seen}</td><td><span class={`tag t-${r.status}`}>{r.status}</span></td><td><a href={r.url} rel="noopener noreferrer">Fuente</a></td><td>{r.read}</td><td>{r.tool}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
