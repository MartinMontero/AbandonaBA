---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import StatCard from '../../components/StatCard.astro';
import TranspNote from '../../components/TranspNote.astro';
import { T, latest, ann, annual, n, voices } from '../../lib/transparencia';
const doors = [
  { href: '/transparencia/mapa/', t: 'Mapa de conexiones', d: 'Todo está conectado. Sigue el dinero y mira con qué se relaciona cada cifra, en dos pasos.', art: 'mapa', feat: true },
  { href: '/transparencia/dinero/', t: '¿De dónde sale el dinero?', d: 'Cinco años de intereses, reservas y comisiones del banco.', art: 'store' },
  { href: '/transparencia/utilidades/', t: '¿Cuánto gana el banco?', d: 'Utilidad por año, dividendos y una comparación con otros bancos.', art: 'spark' },
  { href: '/transparencia/directivos/', t: '¿Cuánto ganan los jefes?', d: 'Lo que el banco y Grupo Elektra publican sobre pagos a directivos.', art: 'briefcase' },
  { href: '/transparencia/sueldos/', t: '¿Cuánto pagan al personal?', d: 'Ofertas de empleo, plantilla y salario mínimo.', art: 'clipboard' },
  { href: '/transparencia/impuestos/', t: 'Impuestos y tribunales', d: 'Lo que dicen la autoridad, los tribunales y la propia empresa.', art: 'shield' },
  { href: '/transparencia/quien-es-quien/', t: '¿Quién es quién?', d: 'Cómo se relacionan el banco y el grupo, según sus documentos.', art: 'steps' },
  { href: '/transparencia/linea-de-tiempo/', t: 'Línea de tiempo', d: 'Los hechos con fecha, en orden.', art: 'book' },
  { href: '/transparencia/equivalencias/', t: 'Compáralo tú mismo', d: 'Convierte una cantidad en años de salario mínimo.', art: 'spark' },
  { href: '/transparencia/como-verificarlo/', t: 'Cómo verificarlo tú', d: 'Enlaces directos a cada documento y qué no prueba.', art: 'help' },
  { href: '/transparencia/metodo/', t: 'Método y derecho de réplica', d: 'Las reglas que seguimos y cómo pedir una corrección.', art: 'book' },
];
const a25 = ann(2025);
const ag = T.tax.elektra;
const g = T.compensation.group;
// Tarjeta 1: utilidad de enero a septiembre, dos años
const uNow = latest.net_ytd as number, uPrev = latest.net_ytd_prev as number;
const uChange = ((uNow - uPrev) / uPrev) * 100;
const uMax = Math.max(uNow, uPrev);
// Tarjeta 2: personal al cierre de cada año
const emp = annual.filter((a: any) => a.year >= 2022 && a.employees_direct);
const eMax = Math.max(...emp.map((a: any) => a.employees_direct));
const eBars = emp.map((a: any, i: number) => { const h = (a.employees_direct / eMax) * 42; return { year: a.year, v: n(a.employees_direct), x: 18 + i * 75, h, y: 58 - h, last: i === emp.length - 1 }; });
// Tarjeta 4: adeudo fiscal, pago inicial y resto
const initShare = ag.initial_payment_mdp / ag.total_mdp;
const sources = [
  { title: latest.source_name, url: latest.source_url, read: latest.read_date },
  { title: g.source_name, url: g.source_url, read: g.read_date },
  { title: ag.source_name, url: ag.source_url, read: ag.read_date },
];
---
<Base art="shield" eyebrow="Para todos" title="Los documentos hablan. Aquí están, con su fuente y su fecha." description="Qué dicen los documentos públicos sobre cómo gana dinero Banco Azteca, qué publican el banco y su grupo sobre lo que pagan a directivos y a su personal, y qué dicen la autoridad y la empresa sobre los impuestos." path="/transparencia/" legal transp claims={['T01','T11','T12','T15','T19']} sources={sources} lead>
  <TranspNote />

  <h2>Lo esencial</h2>
  <p class="ess-intro">Cuatro cifras para empezar. Toca una tarjeta para ver el detalle.</p>
  <ul class="ess">
    <StatCard kicker="Utilidad del banco" big={n(uNow)} unit="millones de pesos, de enero a septiembre de 2026" voice={latest.voice} status={latest.status} source={latest.source_url} href="/transparencia/mapa/#b-1" go="Ver por qué cambió">
      <svg class="chart sm" viewBox="0 0 300 46" role="img" aria-label={`Utilidad de enero a septiembre, en millones de pesos: 2025, ${n(uPrev)}; 2026, ${n(uNow)}.`}>
        <text x="0" y="15" class="mu">Ene–sep 2025</text>
        <rect x="92" y="3" width={((uPrev / uMax) * 150).toFixed(1)} height="16" class="q-admin" />
        <text x={(92 + (uPrev / uMax) * 150 + 6).toFixed(1)} y="15" class="vl">{n(uPrev)}</text>
        <text x="0" y="39" class="mu">Ene–sep 2026</text>
        <rect x="92" y="27" width={((uNow / uMax) * 150).toFixed(1)} height="16" class="q-people" />
        <text x={(92 + (uNow / uMax) * 150 + 6).toFixed(1)} y="39" class="vl">{n(uNow)}</text>
      </svg>
      <Fragment slot="note">{`${uChange < 0 ? 'Bajó' : 'Subió'} `}<strong>{n(Math.abs(uChange))}%</strong>{' frente al mismo periodo de 2025.'}</Fragment>
    </StatCard>

    <StatCard kicker="Personal del banco" big={n(a25.employees_direct)} unit="personas contratadas directamente, al cierre de 2025" voice={a25.voice} status={a25.status} source={a25.notes_url} href="/transparencia/mapa/#d-1" go="Ver cómo cambió">
      <svg class="chart sm" viewBox="0 0 300 78" role="img" aria-label={`Personas que contrata el banco, al cierre de cada año: ${emp.map((a: any) => `${a.year}, ${n(a.employees_direct)}`).join('; ')}.`}>
        <line x1="4" x2="296" y1="58" y2="58" class="axis" />
        {eBars.map((b) => (
          <g>
            <rect x={b.x} y={b.y.toFixed(1)} width="42" height={b.h.toFixed(1)} class={b.last ? 'q-people' : 'q-admin'} />
            <text x={b.x + 21} y={(b.y - 4).toFixed(1)} text-anchor="middle" class="vl">{b.v}</text>
            <text x={b.x + 21} y="73" text-anchor="middle" class="mu">{b.year}</text>
          </g>
        ))}
      </svg>
      <Fragment slot="note">No es el número de cajeros: no hay un número auditado de cajeros.</Fragment>
    </StatCard>

    <StatCard kicker="Pagos a directivos" big={n(g.amount_mdp, 1)} unit="millones de pesos en 2025, de Grupo Elektra y sus subsidiarias" voice={g.voice} status={g.status} source={g.source_url} href="/transparencia/directivos/" go="Ver el detalle">
      <ul class="ess-chips">
        <li>Es un total de varias personas</li>
        <li>No es un sueldo</li>
        <li>No dice cuántas personas son</li>
      </ul>
      <Fragment slot="note">Incluye a consejeros, directivos relevantes y personas relacionadas.</Fragment>
    </StatCard>

    <StatCard kicker="Adeudo fiscal del grupo" big={n(ag.total_mdp)} unit="millones de pesos en parcialidades, según Grupo Elektra" voice={ag.voice} status={ag.status} source={ag.source_url} href="/transparencia/impuestos/" go="Ver el detalle">
      <svg class="chart sm" viewBox="0 0 300 24" role="img" aria-label={`Del total, ${n(ag.initial_payment_mdp)} millones fueron el pago inicial y ${n(ag.remaining_mdp)} millones quedan en ${ag.installments} parcialidades.`}>
        <rect x="0" y="3" width={(initShare * 300).toFixed(1)} height="18" class="q-people" />
        <rect x={(initShare * 300).toFixed(1)} y="3" width={((1 - initShare) * 300).toFixed(1)} height="18" class="q-wage" />
      </svg>
      <ul class="legend-inline">
        <li><i class="sw q-people"></i>Pago inicial: {n(ag.initial_payment_mdp)}</li>
        <li><i class="sw q-wage"></i>Resto, en {ag.installments} pagos: {n(ag.remaining_mdp)}</li>
      </ul>
      <Fragment slot="note">Por juicios de ISR ya resueltos. El pago inicial fue el 29 de enero de 2026.</Fragment>
    </StatCard>
  </ul>

  <h2>¿Qué quieres saber?</h2>
  <ul class="tiles">
    {doors.map((x) => (
      <li class={x.feat ? 'feat' : undefined}><a class="tile" href={x.href}><Art name={x.art} /><span><h3>{x.t}</h3><p>{x.d}</p></span></a></li>
    ))}
  </ul>

  <details class="acc" id="leer"><summary>Cómo leer esta sección</summary><div class="acc-b">
    <p>Cada dato lleva dos etiquetas. La primera dice <strong>quién lo dice</strong>. La segunda dice <strong>qué tanto lo verificamos</strong>.</p>
    <ul>
      {Object.entries(voices).map(([k, v]) => <li><span class="tag t-voz">{v}</span> {k === 'calculo' ? 'Una cuenta que hicimos nosotros, con la fórmula a la vista.' : k === 'empresa' ? 'Viene de un documento de la empresa o de una declaración suya.' : k === 'plataforma' ? 'Calificaciones de usuarios que publica otra plataforma, como Indeed o Glassdoor.' : k === 'medio' ? 'Lo vimos en un medio de comunicación.' : k === 'tribunal' ? 'Viene de una resolución de un tribunal.' : 'Viene de un documento de una autoridad.'}</li>)}
    </ul>
    <p>Lo que una parte solo afirma se escribe como afirmación suya, nunca como hecho. Cuando algo no está publicado o no lo encontramos, la página dice «no publicado» y qué buscamos.</p>
  </div></details>
</Base>
