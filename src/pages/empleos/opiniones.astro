---
import Base from '../../layouts/Base.astro';
import data from '../../data/opiniones-empleados.json';
const emp = data.employers as any[];
const nf = (x: number) => x.toLocaleString('es-MX');
const rf = (x: number) => x.toLocaleString('es-MX', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const platforms = ['Indeed', 'Glassdoor', 'Computrabajo'];
// Calificación que se muestra en la tarjeta del banco: el promedio simple de lo que leímos.
const avg = (e: any) => { const r = e.sources.filter((s: any) => s.rating !== null).map((s: any) => s.rating); return r.length ? r.reduce((a: number, b: number) => a + b, 0) / r.length : null; };
const sources = [
  ...emp.flatMap((e) => e.sources.map((s: any) => ({ title: `${e.name} en ${s.platform}`, url: s.url, read: s.read_date }))),
  { title: data.api.glassdoor_official.source_name, url: data.api.glassdoor_official.source_url, read: data.api.glassdoor_official.read_date },
  { title: 'Zuplo: What is the Glassdoor API?', url: data.api.glassdoor_official.second_url, read: data.api.glassdoor_official.read_date },
];
const tips = [
  ['📅', 'La fecha', 'Busca reseñas recientes.'],
  ['#', 'Cuántas hay', 'Con pocas reseñas, un par de opiniones mueven el promedio.'],
  ['📍', 'Puesto y lugar', 'Filtra por tu puesto y tu ciudad.'],
  ['🔁', 'Lo que se repite', 'Una queja aislada es opinión; la misma en muchas, una señal.'],
];
---
<Base art="spark" eyebrow="Banco de empleo" title="Opiniones de quienes trabajan ahí" description="Elige un banco y mira qué calificación le dan en cada plataforma." path="/empleos/opiniones/" legal claims={['T17','T18']} sources={sources}>
  <p class="lede">Elige un banco. Verás su calificación en cada plataforma y un botón para leer las reseñas allá. <span class="tag t-voz">Datos de otras plataformas · 23-nov-2026</span></p>

  <fieldset class="pick compact">
    <legend>¿Qué banco te interesa?</legend>
    <div class="pick-opts">
      {emp.map((e, i) => (<>
        <input type="radio" name="banco" id={`c${i + 1}`} checked={i === 0} />
        <label for={`c${i + 1}`}><b>{e.name}</b><span>{avg(e) === null ? 'sin cifra' : `${rf(avg(e) as number)} de 5`}</span></label>
      </>))}
      <div class="pick-out" aria-live="polite">
        {emp.map((e, i) => (
          <section class={`pk pk${i + 1}`} aria-label={e.name}>
            <h2>{e.name}</h2>
            <ul class="rate-grid">
              {e.sources.map((s: any) => (
                <li class="rate-card">
                  <h3>{s.platform}</h3>
                  <p class="rate-big">{s.rating === null ? <span class="rate-none">—</span> : <>{rf(s.rating)}<small>/ {s.scale}</small></>}</p>
                  {s.rating !== null && <meter min="0" max={s.scale} value={s.rating} aria-label={`${s.platform}: ${rf(s.rating)} de ${s.scale}`}></meter>}
                  <p class="rate-count">{s.review_count === null ? '—' : `${nf(s.review_count)} reseñas`}{s.review_count !== null && s.review_count < 100 ? <span class="chip-warn">pocas</span> : null}</p>
                  <a class="btn" href={s.url} rel="noopener noreferrer">Ver reseñas</a>
                  {s.note && <details class="mini"><summary>Nota</summary><p>{s.note}</p></details>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </fieldset>

  <h2>Todos juntos</h2>
  <div class="tbl-wrap">
    <table class="cmp">
      <thead><tr><th scope="col">Banco</th>{platforms.map((pl) => <th scope="col">{pl}</th>)}</tr></thead>
      <tbody>
        {emp.map((e) => (
          <tr>
            <th scope="row">{e.name}</th>
            {platforms.map((pl) => {
              const s = e.sources.find((x: any) => x.platform === pl);
              return <td>{s && s.rating !== null ? <><strong>{rf(s.rating)}</strong><meter min="0" max="5" value={s.rating} aria-label={`${e.name} en ${pl}: ${rf(s.rating)} de 5`}></meter></> : <span class="rate-none">—</span>}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="ref-line">Cada plataforma calcula distinto: no se pueden restar entre sí. No ordenamos los bancos.</p>

  <details class="acc" id="leer"><summary>Cómo leer una reseña</summary><div class="acc-b">
    <ul class="tips-mini">{tips.map(([ic, t, d]) => <li><span aria-hidden="true">{ic}</span> <strong>{t}.</strong> {d}</li>)}</ul>
  </div></details>

  <details class="acc" id="por-que"><summary>Por qué no copiamos reseñas</summary><div class="acc-b">
    <ul>
      <li>Glassdoor ya no ofrece API pública y sus términos prohíben raspar su contenido sin permiso. <a href="https://web.archive.org/web/20261116074029/https://www.glassdoor.com/about/terms/" rel="noopener noreferrer">Términos (copia del Internet Archive)</a></li>
      <li>Las reseñas son de quienes las escribieron. Aquí solo mostramos calificaciones y enlaces.</li>
    </ul>
  </div></details>

  <details class="acc" id="bloqueado"><summary>Cifras que faltan (—)</summary><div class="acc-b">
    <ul>
      {(data.blocked as any[]).map((b) => <li><a href={b.url} rel="noopener noreferrer">{b.platform}</a> pidió verificación contra robots y no se saltó.</li>)}
      <li>Si abres esas páginas en tu navegador y pasas la verificación, podemos leer la cifra y sustituir la que sale de una búsqueda.</li>
    </ul>
  </div></details>

  <p><a class="btn tonal" href="/empleos/">Volver al banco de empleo</a> <a class="btn tonal" href="/transparencia/sueldos/">Ver sueldos ofrecidos</a></p>
</Base>
