---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import '../styles/empleos.css';
import data from '../data/empleos.json';
import vac from '../data/vacantes.json';

const roles = [
  { id: 'cajero', label: 'Cajero/a', sub: 'Ventanilla y caja', family: 'Cajero y servicio' },
  { id: 'asesor', label: 'Asesor/a financiero', sub: 'Ventas y crédito', family: 'Asesor, ventas y crédito' },
  { id: 'cobranza', label: 'Gestor/a de cobranza', sub: 'Campo y teléfono', family: 'Cobranza y campo' },
  { id: 'verificador', label: 'Verificador/a', sub: 'Fraude y cumplimiento', family: 'Verificación, fraude y cumplimiento' },
  { id: 'gerente', label: 'Gerente de sucursal', sub: 'Equipo y operación', family: 'Gerencia de sucursal' },
  { id: 'oficinas', label: 'Oficinas centrales', sub: 'Operaciones y análisis', family: '' },
];
const types: [string, string][] = [['todos', 'Todos'], ['banco', 'Bancos'], ['banco-digital', 'Bancos sin sucursales'], ['fintech', 'Fintech'], ['gobierno', 'Gobierno'], ['remesas', 'Remesas y atención']];
const typeLabel: Record<string, string> = { banco: 'Banco', 'banco-digital': 'Banco sin sucursales', fintech: 'Fintech', gobierno: 'Gobierno', remesas: 'Remesas y atención' };

// Estimación nuestra del encaje por tipo de empleador (0 a 3). Si vimos vacantes reales de tu perfil, sube a 3.
const prior: Record<string, Record<string, number>> = {
  banco: { cajero: 3, asesor: 3, cobranza: 2, verificador: 2, gerente: 3, oficinas: 2 },
  'banco-digital': { cajero: 0, asesor: 2, cobranza: 1, verificador: 2, gerente: 1, oficinas: 3 },
  fintech: { cajero: 1, asesor: 2, cobranza: 3, verificador: 3, gerente: 1, oficinas: 2 },
  gobierno: { cajero: 3, asesor: 2, cobranza: 1, verificador: 1, gerente: 2, oficinas: 2 },
  remesas: { cajero: 3, asesor: 2, cobranza: 0, verificador: 2, gerente: 2, oficinas: 1 },
};
const generic: Record<string, string> = {
  cajero: 'Busca «cajero» o «personal de cajas»',
  asesor: 'Busca «ejecutivo» o «asesor»',
  cobranza: 'Busca «cobranza» o «recuperación»',
  verificador: 'Busca «prevención de fraude» o «KYC»',
  gerente: 'Busca «gerente de sucursal»',
  oficinas: 'Filtra por tu área: operaciones, riesgos o cumplimiento',
};
const linkText: Record<string, string> = { abierto: 'Abierto por nosotros', enlace: 'Enlace sin abrir', sitio: 'Solo sitio principal', caido: 'Sitio sin respuesta' };

const seenBy = new Map((vac as any).companies.map((c: any) => [c.company, c]));
const cards = (data as any).employers.map((e: any) => {
  const s: any = e.seen ? seenBy.get(e.seen) : null;
  const perRole: Record<string, { fit: number; count: number; ex: any }> = {};
  for (const r of roles) {
    const list = s?.examples?.[r.family] ?? [];
    const count = s && r.family ? (s.counts?.[r.family] ?? list.length) : 0;
    const fit = count > 0 ? 3 : (prior[e.type]?.[r.id] ?? 1);
    perRole[r.id] = { fit, count, ex: list[0] ?? null };
  }
  return { ...e, perRole, seenFit: s?.fit_count ?? null };
});
const initials = (n: string) => n.replace(/\(.*?\)/g, '').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const hue = (n: string) => [...n].reduce((a, c) => a + c.charCodeAt(0), 0) % 6;
const sources = [];
const tips = [
  { art: 'shield', t: 'Postula en privado', d: 'Desde tu teléfono o computadora personal, no desde equipos ni Wi-Fi del banco.' },
  { art: 'clipboard', t: 'Lleva tu currículum listo', d: 'Frases para cada puesto en Buscar trabajo.', href: '/trabajo/', a: 'Ver frases' },
  { art: 'news', t: 'Ojo con los filtros', d: 'Algunas ofertas del Grupo Salinas piden «no haber laborado en Grupo Salinas». Se reporta en ofertas y reseñas.' },
  { art: 'calc', t: 'Confirma en el enlace', d: `Vacantes vistas el ${(vac as any).seen}; cambian a diario. El encaje es una estimación nuestra.` },
];
---
<Base art="briefcase" eyebrow="Banco de empleo" title="Encuentra dónde encajas" description="Bancos y fintech en un solo lugar. Elige lo que haces hoy y te mostramos dónde encaja mejor." path="/empleos/" legal claims={['C22','C23']} sources={sources} card="empleos" wide lead>
  <form id="empleos-form" class="tool" role="search" aria-label="Buscar empleo">
    <fieldset class="roles">
      <legend><span class="step">1</span> ¿Qué haces hoy en el banco?</legend>
      <div class="role-grid">
        {roles.map((r) => (
          <label class="role-card"><input type="radio" name="role" value={r.id} /><span class="rc"><Art kind="role" name={r.id} /><strong>{r.label}</strong><small>{r.sub}</small></span></label>
        ))}
      </div>
    </fieldset>

    <div class="filters">
      <fieldset class="chips">
        <legend><span class="step">2</span> ¿Dónde quieres buscar?</legend>
        <div class="chip-row">
          {types.map(([v, l], i) => (
            <label class="chip"><input type="radio" name="type" value={v} checked={i === 0} /><span>{l}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="filter-row">
        <label class="switch"><input type="checkbox" role="switch" id="seen-only" /><span>Solo con vacantes vistas hoy</span></label>
        <div class="search"><label for="q" class="sr-only">Buscar una empresa por nombre</label><input id="q" type="search" autocomplete="off" placeholder="Buscar empresa: Banorte, Nu…" /></div>
      </div>
    </div>
  </form>

  <div class="results-bar">
    <p id="summary" class="summary" aria-live="polite">Elige tu puesto arriba. Mientras tanto, estas son todas las opciones.</p>
    <button type="button" class="btn tonal no-print" id="copy-top">Copiar las 10 mejores</button>
  </div>

  <ol id="cards" class="cards">
    {cards.map((e: any) => (
      <li class="job-card" data-id={e.id} data-type={e.type} data-name={e.name.toLowerCase()} data-seen={e.seenFit ?? 0}
        data-fit-cajero={e.perRole.cajero.fit} data-fit-asesor={e.perRole.asesor.fit} data-fit-cobranza={e.perRole.cobranza.fit} data-fit-verificador={e.perRole.verificador.fit} data-fit-gerente={e.perRole.gerente.fit} data-fit-oficinas={e.perRole.oficinas.fit}
        data-n-cajero={e.perRole.cajero.count} data-n-asesor={e.perRole.asesor.count} data-n-cobranza={e.perRole.cobranza.count} data-n-verificador={e.perRole.verificador.count} data-n-gerente={e.perRole.gerente.count} data-n-oficinas={e.perRole.oficinas.count}
        data-url={e.url}>
        <span class="rank" data-rank hidden></span>
        <div class="job-head">
          <span class={`avatar av-${hue(e.name)}`} aria-hidden="true">{initials(e.name)}</span>
          <div class="job-id">
            <h2>{e.name}</h2>
            <span class="chip-tag">{typeLabel[e.type]}</span>
          </div>
          <span class="fit" data-fit-badge hidden></span>
        </div>
        <div class="meter" data-meter hidden aria-hidden="true"><i></i><i></i><i></i></div>
        {roles.map((r) => (
          <p class="hint-line" data-role-hint={r.id} hidden>
            <strong>{e.hints?.[r.id] ?? generic[r.id]}.</strong>
            {e.perRole[r.id].count > 0 && <span class="seen-pill">{e.perRole[r.id].count} vista{e.perRole[r.id].count === 1 ? '' : 's'} hoy</span>}
            {e.perRole[r.id].ex && <span> Por ejemplo: <a href={e.perRole[r.id].ex.url} rel="noopener noreferrer" target="_blank">{e.perRole[r.id].ex.title}</a>.</span>}
          </p>
        ))}
        <p class="link-note"><span class={`dot dot-${e.link}`} aria-hidden="true"></span>{linkText[e.link]}.{e.link === 'sitio' || e.link === 'enlace' ? ' Si no carga, busca «Trabaja con nosotros».' : ''}{e.link === 'caido' ? ' Prueba de nuevo más tarde.' : ''}</p>
        <div class="job-actions">
          <a class="btn" href={e.url} rel="noopener noreferrer" target="_blank">Ver vacantes<span class="sr-only"> de {e.name} (se abre en otra pestaña)</span></a>
          {e.home !== e.url && <a class="btn text" href={e.home} rel="noopener noreferrer" target="_blank">Sitio principal<span class="sr-only"> de {e.name}</span></a>}
          <label class="switch small"><input type="checkbox" role="switch" class="done" /><span>Ya la revisé</span></label>
        </div>
      </li>
    ))}
  </ol>
  <p id="empty" class="summary" hidden>No hay resultados con esos filtros. Quita «Solo con vacantes vistas» o cambia de lugar.</p>
  <p id="reviewed" class="summary" aria-live="polite"></p>

  <section class="boards-sec" aria-labelledby="bolsas">
    <h2 id="bolsas">Busca en muchas empresas a la vez</h2>
    <p class="muted">Pon el puesto y tu ciudad. Todas son gratis.</p>
    <ul class="board-grid">
      {(data as any).boards.map((b: any) => (
        <li><a class="board" href={b.url} rel="noopener noreferrer" target="_blank"><span class={`avatar lg av-${hue(b.name)}`} aria-hidden="true">{initials(b.name)}</span><span class="board-body"><strong>{b.name}</strong><small>{b.note}</small></span><span class="board-go" aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </section>

  <section class="tips-sec" aria-labelledby="antes">
    <h2 id="antes">Antes de postular</h2>
    <ul class="tips">
      {tips.map((x) => (
        <li class="tip"><Art name={x.art} /><h3>{x.t}</h3><p>{x.d} {x.href && <a href={x.href}>{x.a}</a>}</p></li>
      ))}
    </ul>
  </section>

  <script>import '../scripts/empleos.ts';</script>
</Base>