---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { siteConfig } from '../data/site.config';
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
const check = '<path d="M5 12l4 4 10-10"/>';
const beacons = [
  { href: '/no-firmes/', t: 'Me presionan o me pueden despedir', d: 'Qué no firmar y qué decir hoy mismo.', art: 'shield', cls: 'urgent', go: 'Protegerme' },
  { href: '/calculadora/', t: 'Calcula lo que me toca', d: 'Compara cuatro salidas con tus números.', art: 'calc', cls: 'sea', go: 'Calcular' },
  { href: '/plazos/', t: 'Mis plazos', d: 'Fechas límite y recordatorios en tu teléfono.', art: 'calendar', cls: 'sand', go: 'Ver fechas' },
];
const near = [
  { href: '/salidas/', t: 'Quiero irme', d: 'Qué paga cada salida.', art: 'door' },
  { href: '/checklist-salida/', t: 'Lo que debo y tengo', d: 'Préstamos, ahorro y Afore.', art: 'clipboard' },
  { href: '/ayuda-gratis/', t: 'Ayuda gratis', d: 'Asesoría sin pagar.', art: 'help' },
];
const journey = [
  { t: 'Protégete', d: 'No firmes en blanco ni bajo presión.', art: 'shield', href: '/no-firmes/', a: 'Qué no firmar' },
  { t: 'Calcula', d: 'Mira qué paga cada salida.', art: 'calc', href: '/calculadora/', a: 'Abrir calculadora' },
  { t: 'Decide', d: 'Elige la ruta que cuida tus derechos.', art: 'door', href: '/salidas/', a: 'Ver salidas' },
  { t: 'Empieza de nuevo', d: 'Trabajo, negocio o cooperativa.', art: 'briefcase', href: '/empleos/', a: 'Buscar empleo' },
];
const stats = [
  ['2 meses', 'para reclamar un despido', 'LFT Art. 518'],
  ['1 mes', 'para separarte por culpa del patrón (cuenta 30 días)', 'Arts. 517 y 52'],
  ['45 días', 'máximo de la conciliación', 'Art. 684-E'],
  ['15 años', 'para prima de antigüedad si renuncias', 'Art. 162'],
];
const roles = ['cajero', 'asesor', 'cobranza', 'verificador', 'gerente', 'oficinas'];
const next = [
  { href: '/puente/', t: 'Dinero mientras encuentro trabajo', d: 'IMSS, Afore y programas.', art: 'steps' },
  { href: '/negocio/', t: 'Mi propio negocio', d: 'Ideas y bases fiscales.', art: 'store' },
  { href: '/equipo/', t: 'Con mis compañeros', d: 'Un mensaje para invitar.', art: 'people' },
  { href: '/cooperativa/', t: 'Cooperativa paso a paso', d: 'Cómo se forma y se registra.', art: 'coop' },
  { href: '/inteligencia-aumentada/', t: 'Inteligencia Aumentada', d: 'Diez lecciones cortas.', art: 'spark' },
  { href: '/situacion/', t: 'Qué se dijo y qué no', d: 'Hechos con fuentes.', art: 'news' },
];
---
<Base title={siteConfig.heroTitle} description={siteConfig.heroSub} path="/" hero claims={['C01', 'C04']}>
  <section slot="hero" class="hero2" aria-labelledby="titulo">
    <div class="hero2-in">
      <div class="hero2-copy">
        <p class="pill-eyebrow">Gratis · Sin cuenta · Privado</p>
        <h1 id="titulo">Si decides irte, <span class="hl">sal bien.</span></h1>
        <p class="lead">{siteConfig.heroSub}</p>
        <div class="hero-cta">
          <a class="btn lg" href="/calculadora/">Calcula lo que me toca <svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} /></a>
          <a class="btn lg tonal" href="/no-firmes/">Me presionan para firmar</a>
        </div>
        <ul class="proof">
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />Cada dato con su fuente</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />Nada sale de tu teléfono</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />Funciona sin conexión</li>
        </ul>
      </div>
      <div class="hero2-art"><Art kind="scene" name="hero" class="float" /></div>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="hoy">
    <div class="section-head"><span class="kicker">Empieza aquí</span><h2 id="hoy">¿Qué necesitas hoy?</h2><p>Elige y te llevamos paso a paso.</p></div>
    <ul class="beacons">
      {beacons.map((x) => (
        <li><a class={`beacon ${x.cls}`} href={x.href}><Art name={x.art} /><h3>{x.t}</h3><p>{x.d}</p><span class="go">{x.go} <svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} /></span></a></li>
      ))}
    </ul>
    <ul class="tiles near">
      {near.map((x) => (
        <li><a class="tile" href={x.href}><Art name={x.art} /><span><h3>{x.t}</h3><p>{x.d}</p></span></a></li>
      ))}
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="ruta">
    <div class="section-head"><span class="kicker">Tu camino</span><h2 id="ruta">Tu ruta en cuatro pasos</h2><p>Sin prisa, pero sin esperar: los plazos corren.</p></div>
    <ol class="journey">
      {journey.map((x) => (
        <li><span class="badge"><Art name={x.art} /></span><div><h3>{x.t}</h3><p>{x.d}</p><a href={x.href}>{x.a}</a></div></li>
      ))}
    </ol>
  </section>

  <section class="section reveal" aria-labelledby="ley">
    <div class="night">
      <h2 id="ley">La ley te respalda, pero el reloj corre</h2>
      <p class="sub">Leído en el texto oficial de la Ley Federal del Trabajo. <span class="tag t-verificado-primaria">verificado-primaria</span></p>
      <ul class="stats">
        {stats.map(([n, t, s]) => <li class="stat"><strong>{n}</strong><span>{t}</span><small>{s}</small></li>)}
      </ul>
      <p class="mt-2"><a class="btn sun" href="/plazos/">Calcular mis fechas</a></p>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="empleo">
    <div class="feature">
      <div>
        <span class="kicker kicker-on">Después de salir</span>
        <h2 id="empleo">Tu próximo trabajo está en la lista</h2>
        <p>Bancos y fintech en un solo lugar. Elige lo que haces hoy y mira dónde encajas mejor.</p>
        <ul class="role-row" aria-hidden="true">
          {roles.map((r) => <li><Art kind="role" name={r} /></li>)}
        </ul>
        <a class="btn lg sun" href="/empleos/">Encontrar dónde encajo <svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} /></a>
      </div>
      <Art name="briefcase" class="art-spot float" />
    </div>
  </section>

  <section class="section reveal" aria-labelledby="mas">
    <div class="section-head"><span class="kicker">Más caminos</span><h2 id="mas">Y si quieres empezar algo propio</h2></div>
    <ul class="tiles">
      {next.map((x) => (
        <li><a class="tile" href={x.href}><Art name={x.art} /><span><h3>{x.t}</h3><p>{x.d}</p></span></a></li>
      ))}
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="confianza">
    <div class="section-head"><h2 id="confianza">Hecho para que confíes</h2></div>
    <ul class="trust">
      <li><Art name="shield" /><h3>Privado</h3><p>Sin cuentas, sin cookies. Lo que escribes no sale de tu teléfono.</p></li>
      <li><Art name="book" /><h3>Verificado</h3><p>Cada dato dice si lo leímos en la fuente oficial o no.</p></li>
      <li><Art name="people" /><h3>Abierto</h3><p>Código y textos libres. <a href="/acerca/">Cómo trabajamos</a>.</p></li>
    </ul>
  </section>
</Base>
