---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../data/site.config';
const I = {
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M12 8v4M12 15.5h.01"/>',
  calc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h2M12 12h2M8 16h2M12 16h2"/>',
  cal: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  door: '<path d="M10 5H5v14h5M15 8l4 4-4 4M19 12H9"/>',
  list: '<path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 115 0c0 1.5-2.5 2-2.5 3.5M12 17h.01"/>',
  wallet: '<path d="M4 7h14a2 2 0 012 2v9a2 2 0 01-2 2H6a2 2 0 01-2-2V7z"/><path d="M4 7V6a2 2 0 012-2h10M16 13.5h2"/>',
  work: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18"/>',
  store: '<path d="M4 9l1-5h14l1 5M4 9v11h16V9M4 9a2.5 2.5 0 005 0 2.5 2.5 0 005 0 2.5 2.5 0 005 0M9 20v-6h6v6"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3 2.5-5 6-5s6 2 6 5M17 11a2.5 2.5 0 100-5M21 20c0-2.2-1.5-3.8-4-4.5"/>',
  heart: '<path d="M12 21s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.6-7 10-7 10z"/>',
  spark: '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
  news: '<path d="M5 4h11l3 3v13H5zM9 11h6M9 15h6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M5 12l4 4 10-10"/>',
};
const today = [
  { href: '/no-firmes/', t: 'Me presionan o me pueden despedir', d: 'Qué no firmar, qué decir y qué hacer hoy mismo.', i: I.shield, cls: 'urgent' },
  { href: '/calculadora/', t: 'Calcula lo que me toca', d: 'Compara cuatro formas de salir con tus propios números.', i: I.calc, cls: '' },
  { href: '/plazos/', t: 'Mis plazos', d: 'Las fechas límite para reclamar, con recordatorios.', i: I.cal, cls: '' },
  { href: '/salidas/', t: 'Quiero irme', d: 'Qué paga cada salida y qué riesgo tiene.', i: I.door, cls: '' },
  { href: '/checklist-salida/', t: 'Lo que debo y tengo en el banco', d: 'Préstamos, ahorro, nómina, Afore y lo que pedir por escrito.', i: I.list, cls: '' },
  { href: '/ayuda-gratis/', t: 'Ayuda gratis', d: 'Dónde pedir asesoría laboral sin pagar.', i: I.help, cls: '' },
];
const after = [
  { href: '/puente/', t: 'Dinero mientras encuentro trabajo', d: 'IMSS, Afore, programas y qué ganas y qué pierdes.', i: I.wallet },
  { href: '/empleos/', t: 'Banco de empleo', d: 'Bancos y fintech en un solo lugar. Ve dónde encajas mejor.', i: I.work, cls: 'accent' },
  { href: '/negocio/', t: 'Mi propio negocio', d: 'Ideas con lo que ya sabes y las bases fiscales.', i: I.store },
  { href: '/equipo/', t: 'Con mis compañeros', d: 'Un mensaje para invitar y una agenda para empezar.', i: I.people },
  { href: '/cooperativa/', t: 'Cooperativa paso a paso', d: 'Cómo se forma y se registra, y qué dice la ley.', i: I.heart },
  { href: '/inteligencia-aumentada/', t: 'Inteligencia Aumentada', d: 'Diez lecciones cortas para redactar y prepararte.', i: I.spark },
];
const stats = [
  ['2 meses', 'para reclamar un despido', 'LFT Art. 518'],
  ['1 mes', 'para separarte por culpa del patrón (cuenta 30 días por precaución)', 'LFT Arts. 517 y 52'],
  ['45 días', 'máximo de la conciliación antes del juicio', 'LFT Art. 684-E'],
  ['15 años', 'de servicio para cobrar prima de antigüedad si renuncias', 'LFT Art. 162'],
];
---
<Base title={siteConfig.heroTitle} description={siteConfig.heroSub} path="/" hero claims={['C01', 'C04']}>
  <section slot="hero" class="hero" aria-labelledby="titulo">
    <div class="hero-inner">
      <div>
        <p class="eyebrow">Gratis · Sin cuenta · Nada sale de tu teléfono</p>
        <h1 id="titulo">{siteConfig.heroTitle}</h1>
        <p class="lead">{siteConfig.heroSub}</p>
        <p>
          <a class="btn lg" href="/calculadora/">Calcula lo que me toca <svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.arrow} /></a>
          <a class="btn lg tonal" href="/no-firmes/">Me presionan para firmar</a>
        </p>
        <ul class="hero-points">
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.check} />Cada dato con su fuente</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.check} />Sin cookies ni estadísticas</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.check} />Funciona sin conexión</li>
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 400 360" fill="none">
          <rect class="art-card" x="40" y="60" width="230" height="270" rx="24" transform="rotate(-6 155 195)" />
          <rect class="art-card" x="90" y="30" width="230" height="270" rx="24" />
          <path class="art-line" d="M125 80h120M125 110h160M125 140h140M125 170h90" />
          <path class="art-shield" d="M250 150l62 24v52c0 40-27 66-62 80-35-14-62-40-62-80v-52z" />
          <path class="art-check" d="M222 232l20 20 36-40" />
          <circle class="art-dot" cx="330" cy="70" r="12" />
          <circle class="art-dot" cx="60" cy="300" r="8" />
        </svg>
      </div>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="hoy">
    <div class="section-head"><h2 id="hoy">¿Qué necesitas hoy?</h2><p>Elige tu situación. Cada camino te lleva paso a paso.</p></div>
    <ul class="tiles">
      {today.map((x) => (
        <li><a class={`tile ${x.cls}`} href={x.href}><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={x.i} /></span><h3>{x.t}</h3><p>{x.d}</p><span class="go">Entrar <svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.arrow} /></span></a></li>
      ))}
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="ruta">
    <div class="section-head"><h2 id="ruta">Tu ruta en tres pasos</h2><p>Sin prisa, pero sin esperar: los plazos corren.</p></div>
    <ol class="steps">
      <li><div><h3>Protégete</h3><p>No firmes en blanco ni bajo presión. Guarda copias en tu propio teléfono.</p><a href="/no-firmes/">Ver qué no firmar</a></div></li>
      <li><div><h3>Calcula</h3><p>Mira qué paga cada salida con tu sueldo y tu antigüedad. Todo queda en tu aparato.</p><a href="/calculadora/">Abrir la calculadora</a></div></li>
      <li><div><h3>Decide y reúne pruebas</h3><p>Elige la ruta que conserva tus derechos y guarda la evidencia sin meterte en problemas.</p><a href="/evidencia/">Qué guardar</a></div></li>
    </ol>
  </section>

  <section class="section reveal" aria-labelledby="ley">
    <div class="section-head"><h2 id="ley">Lo que dice la ley, en corto</h2><p>Leído en el texto oficial de la Ley Federal del Trabajo. <span class="tag t-verificado-primaria">verificado-primaria</span></p></div>
    <ul class="stats">
      {stats.map(([n, t, s]) => <li class="stat"><strong>{n}</strong><span>{t}</span><small>{s}</small></li>)}
    </ul>
    <p class="mt-2"><a class="btn tonal" href="/plazos/">Calcular mis fechas</a></p>
  </section>

  <section class="section reveal" aria-labelledby="despues">
    <div class="section-head"><h2 id="despues">Después de salir</h2><p>Un empleo nuevo, tu propio negocio o una cooperativa con tus compañeros.</p></div>
    <ul class="tiles">
      {after.map((x) => (
        <li><a class={`tile ${x.cls ?? ''}`} href={x.href}><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={x.i} /></span><h3>{x.t}</h3><p>{x.d}</p><span class="go">Ver <svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.arrow} /></span></a></li>
      ))}
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="que-paso">
    <div class="band">
      <div>
        <h2 id="que-paso">¿Qué se dijo y qué no está confirmado?</h2>
        <p>Si tu puesto desaparece porque una máquina o un proceso nuevo hace tu trabajo, el Art. 439 de la Ley Federal del Trabajo exige un convenio o la autorización del Tribunal. Aquí separamos hechos de rumores, con fuentes.</p>
      </div>
      <p><a class="btn" href="/situacion/"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.news} /> Ver los hechos</a></p>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="confianza">
    <div class="section-head"><h2 id="confianza">Hecho para que confíes</h2></div>
    <ul class="trust">
      <li><h3>Privado</h3><p>Lo que escribes no sale de tu aparato. No hay cuentas, cookies ni estadísticas. Hay botón de salida rápida en todas las páginas.</p></li>
      <li><h3>Verificado</h3><p>Cada dato lleva una etiqueta: leído en la fuente oficial, visto solo en prensa o sin verificar. Nunca la subimos sin leer la fuente.</p></li>
      <li><h3>Abierto</h3><p>El código y los textos son libres. Cualquiera puede corregir un valor y publicarlo gratis. <a href="/acerca/">Cómo trabajamos</a>.</p></li>
    </ul>
  </section>
</Base>
