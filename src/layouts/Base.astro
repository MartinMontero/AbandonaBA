---
import '../styles/global.css';
import { siteConfig, legalReview, financialReview, statusLabels, isReview } from '../data/site.config';
import ReviewPanel from '../components/ReviewPanel.astro';
import ShareRow from '../components/ShareRow.astro';
import Art from '../components/Art.astro';

export interface Source { title: string; url: string; read: string }
export interface TocItem { depth: number; slug: string; text: string }
interface Props {
  title: string;
  description?: string;
  path: string; // ruta con barra inicial y final, p. ej. "/salidas/"
  lang?: 'es' | 'en';
  legal?: boolean;
  finance?: boolean; // páginas de Cámbiate: nota de revisión financiera
  claims?: string[];
  decisions?: string[];
  sources?: Source[];
  card?: string;
  wide?: boolean;
  hero?: boolean; // la página trae su propia portada y encabezado
  eyebrow?: string;
  lead?: boolean; // muestra la descripción como entrada del texto
  toc?: TocItem[];
  art?: string; // ilustración del encabezado
}
const { title, description = '', path, lang = 'es', legal = false, finance = false, claims = [], decisions = [], sources = [], card, wide = false, hero = false, eyebrow = '', lead = false, toc = [], art = 'shield' } = Astro.props;
const es = lang === 'es';
const basePath = path.replace(/^\/en\//, '/');
const altEs = basePath;
const altEn = '/en' + (basePath === '/' ? '/' : basePath);
const fullTitle = path === '/' || path === '/en/' ? title : `${title} · ${siteConfig.name}`;
const nav = [
  ['/', 'Inicio', '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>'],
  ['/calculadora/', 'Calcular', '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h2M12 12h2M8 16h2M12 16h2"/>'],
  ['/plazos/', 'Plazos', '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>'],
  ['/empleos/', 'Empleos', '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18"/>'],
  ['/emprender/', 'Emprender', '<path d="M12 21v-9"/><path d="M12 13c0-4 3-6.5 8-6.5 0 4.5-3 6.5-8 6.5z"/><path d="M12 16c0-3-2-5-6.5-5 0 3.5 2.5 5 6.5 5z"/>'],
  ['/cambiate/', 'Cámbiate', '<path d="M4 8h13l-3.5-3.5"/><path d="M20 16H7l3.5 3.5"/>'],
  ['/inteligencia-aumentada/', 'Nivel', '<path d="M12 19V6"/><path d="M6 12l6-6 6 6"/><path d="M5 21h14"/>'],
  ['/ayuda-gratis/', 'Ayuda', '<circle cx="12" cy="12" r="9"/><path d="M15.6 8.4l-2.1 5.1-5.1 2.1 2.1-5.1z"/>'],
];
// «Emprender» también se marca en las páginas que cuelgan de él.
const groups: Record<string, string[]> = { '/emprender/': ['/negocio/', '/equipo/', '/cooperativa/', '/puente/'] };
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href) || (groups[href] ?? []).some((g) => path.startsWith(g)));
const isCustomer = path.startsWith('/cambiate/');
const ogImage = card ? `${siteConfig.siteUrl}/cards/${card}-1080x1080.png` : '';
const tocItems = toc.filter((t) => t.depth === 2);
const hasToc = tocItems.length >= 3;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0045fc" />
    {isReview && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="es" href={siteConfig.siteUrl + altEs} />
    {['/', '/situacion/', '/acerca/'].includes(basePath) && <link rel="alternate" hreflang="en" href={siteConfig.siteUrl + altEn} />}
    <link rel="alternate" hreflang="x-default" href={siteConfig.siteUrl + altEs} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && !isReview && <meta property="og:image" content={ogImage} />}
  </head>
  <body data-exit-url={siteConfig.quickExitUrl} data-lang={lang}>
    {isReview && <div class="review-banner" role="note">{siteConfig.reviewBanner}</div>}
    <div class="bank-warning" role="note">{es ? siteConfig.bankWarning : 'Do not use bank devices, Wi-Fi or internet to visit this page.'}</div>
    <div id="offline-banner" class="offline" role="status" hidden>{es ? 'Sin conexión. Puedes seguir usando las páginas que ya abriste.' : 'You are offline. Pages you already opened still work.'}</div>
    <a class="skip" href="#contenido">{es ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="top" id="app-bar">
      <a class="brand" href={es ? '/' : '/en/'}>
        <span class="brand-mark" aria-hidden="true"><img src="/flag-96.png" alt="" width="40" height="40" /></span>
        <span class="brand-text">{siteConfig.name}<small>{es ? 'Tus derechos, claros' : 'Your rights, clear'}</small></span>
      </a>
      {es && (
        <nav class="audience" aria-label="Elige tu camino">
          <a href="/" aria-current={isCustomer ? undefined : 'page'}>Soy empleado</a>
          <a href="/cambiate/" aria-current={isCustomer ? 'page' : undefined}>Soy cliente</a>
        </nav>
      )}
      <button type="button" class="quick-exit" id="quick-exit" aria-label={es ? 'Salida rápida: abre otra página al instante' : 'Quick exit'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6H5v12h4M14 8l4 4-4 4M18 12H9" /></svg>
        {es ? 'Salida rápida' : 'Quick exit'}
      </button>
    </header>
    {es && (
      <nav class="navbar" aria-label="Principal">
        <ul>
          {nav.map(([href, label, icon]) => (
            <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}><span class="pill"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icon} /></span><span>{label}</span></a></li>
          ))}
        </ul>
      </nav>
    )}
    <div id="snackbar" class="snackbar" role="status" aria-live="polite" hidden></div>
    <main id="contenido" class={`${!wide && !hero ? 'narrow' : ''}${hasToc ? ' has-toc' : ''}`.trim()}>
      {hero ? (
        <slot name="hero" />
      ) : (
        <header class="page-head">
          <div class="page-head-in">
            <div>
              {eyebrow && <p class="eyebrow">{eyebrow}</p>}
              <h1>{title}</h1>
              {lead && description && <p class="lead">{description}</p>}
              {finance && (
                <p class="legal-note" role="note">
                  <span class="legal-chip">{financialReview.status === 'pendiente' ? siteConfig.financeNote : `Revisión financiera firmada por ${financialReview.reviewers.join(', ')}.`} Datos al {siteConfig.cambiateDate}. · Última revisión: {financialReview.status === 'pendiente' || !financialReview.fecha ? 'pendiente' : financialReview.fecha}</span>
                </p>
              )}
              {legal && !finance && (
                <p class="legal-note" role="note">
                  <span class="legal-chip">{legalReview.status === 'pendiente' ? siteConfig.legalNote : `Revisión legal firmada por ${legalReview.reviewers.join(', ')}.`} · Última revisión legal: {legalReview.status === 'pendiente' || !legalReview.fecha ? 'pendiente' : legalReview.fecha}</span>
                </p>
              )}
            </div>
            <Art name={art} class="art-head" />
          </div>
        </header>
      )}
      <div class={`page-grid${hasToc ? ' has-toc' : ''}`}>
        <div class={`body${wide || hero ? '' : ' measure'}`}>
          <slot />
          {sources.length > 0 && (
            <section class="sources" aria-labelledby="fuentes">
              <h2 id="fuentes">{es ? 'Fuentes' : 'Sources'}</h2>
              <ul>{sources.map((s) => <li><a href={s.url} rel="noopener noreferrer">{s.title}</a> · {es ? 'leída el' : 'read on'} {s.read}</li>)}</ul>
            </section>
          )}
          {legal && (
            <section class="legend" aria-labelledby="leyenda">
              <h2 id="leyenda">{es ? 'Qué significan las etiquetas' : 'What the labels mean'}</h2>
              <ul>
                {Object.entries(statusLabels).map(([k, v]) => <li><span class={`tag t-${k}`}>{k}</span> {v}</li>)}
              </ul>
            </section>
          )}
          {card && <ShareRow card={card} path={path} />}
          {isReview && legal && <ReviewPanel claims={claims} decisions={decisions} />}
        </div>
        {hasToc && (
          <aside class="toc" aria-label={es ? 'En esta página' : 'On this page'}>
            <h2>{es ? 'En esta página' : 'On this page'}</h2>
            <ul>{tocItems.map((t) => <li><a href={`#${t.slug}`}>{t.text}</a></li>)}</ul>
          </aside>
        )}
      </div>
    </main>
    <footer>
      <div class="foot-inner">
        <div>
          <p><strong>{siteConfig.footerLine}</strong></p>
          <p>{siteConfig.disclaimer}</p>
        </div>
        <div>
          <p class="foot-links">
            <a href="/acerca/">{es ? 'Acerca y privacidad' : 'About'}</a>
            <a href="/glosario/">Glosario</a>
            <a href="/actualizaciones/">Actualizaciones</a>
            <a href={siteConfig.repoUrl} rel="noopener noreferrer">Código abierto</a>
          </p>
          <p class="small">Texto: CC BY-SA 4.0. Código: MIT.</p>
        </div>
      </div>
    </footer>
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
