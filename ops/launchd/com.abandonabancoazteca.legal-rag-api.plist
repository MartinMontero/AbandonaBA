<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abandonabancoazteca.legal-rag-api</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/services/lft-rag/.venv/bin/uvicorn</string>
    <string>src.api:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8090</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__/services/lft-rag</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>__PROJECT_DIR__/services/lft-rag/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/legal-rag-api.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/legal-rag-api.err.log</string>
</dict>
</plist>
