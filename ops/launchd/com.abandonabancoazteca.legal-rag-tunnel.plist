<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abandonabancoazteca.legal-rag-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>__CLOUDFLARED_BIN__</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>__HOME__/.cloudflared/legal-rag-origin.yml</string>
    <string>run</string>
    <string>legal-rag-origin</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__/services/lft-rag</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/legal-rag-tunnel.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/legal-rag-tunnel.err.log</string>
</dict>
</plist>
