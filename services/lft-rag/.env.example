# Copia este archivo a .env (ignorado por git) y ajusta. Nunca subas .env.

# --- Capa de decisión System One: jev | jeff | off ---
# jev  = API de TypeSafe (necesita TYPESAFE_API_KEY). Envía la pregunta, los artículos y el borrador a TypeSafe.
# jeff = Jeff (mstrasser/jeff-base v1.4 + adaptadores passage-relevant y ground). Sólo inglés.
#        JEFF_RUNTIME=remote usa api.jeffhub.ai (JEFF_API_KEY); local requiere Apple silicon o NVIDIA.
# off  = sin compuertas de modelo; la verificación determinista de citas siempre corre.
DECISION_BACKEND=off
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL_ID=jev-1.14.0
JEFF_RUNTIME=remote
JEFF_SERVER_URL=https://api.jeffhub.ai
JEFF_API_KEY=
JEFF_TEMPERATURE=1.0

RELEVANCE_THRESHOLD=1.5
GROUNDEDNESS_THRESHOLD=0.75
HALLUCINATION_THRESHOLD=0.30

# --- Índice ---
# soylic/soylic-embeddings-leyes-mexicanas es de acceso restringido (aprobación manual en Hugging Face).
# Mientras no tengas acceso: ibm-granite/granite-embedding-97m-multilingual-r2 (su modelo base, abierto).
EMBEDDING_MODEL_ID=soylic/soylic-embeddings-leyes-mexicanas
MAX_CHUNK_TOKENS=480
INDEX_DIR=./data/index
CHROMA_COLLECTION=lft_articulos
DENSE_TOP_K=15
BM25_TOP_K=15
RRF_K=60
RRF_CANDIDATES=10
MAX_FILTERED_ARTICLES=5

# --- Generador: transformers | llamacpp | ollama | none ---
# none = sin LLM: devuelve los artículos oficiales recuperados (status SOURCES_ONLY).
GENERATOR_BACKEND=none
GENERATOR_MODEL_ID=Danielbrdz/Barcenas-8b-Juridico-Mexicano
GENERATOR_LOAD_IN_4BIT=true
GENERATOR_GGUF_PATH=
GENERATOR_MAX_NEW_TOKENS=700
GENERATOR_TIMEOUT_S=300
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=rjmalagon/barcena-8b-juridico-mexicano:q8_0

# --- API HTTP y Zero Trust ---
LFT_API_HOST=127.0.0.1
LFT_API_PORT=8090
# Secreto compartido con el Worker (Authorization: Bearer ...). Sólo aceptado desde loopback (127.0.0.1 / ::1) cuando CF_ACCESS_AUD está vacío.
LFT_SERVICE_TOKEN=
LFT_DEV_BYPASS_TOKEN=
# Cloudflare Access Zero Trust (Gate 3 en origen). Cuando CF_ACCESS_AUD está definido, se exige Cf-Access-Jwt-Assertion RS256 válido.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
MAX_QUESTION_CHARS=1000
